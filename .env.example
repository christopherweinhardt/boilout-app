# Slack app credentials from https://api.slack.com/apps → Basic Information
SLACK_APP_ID=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# Any long random string used to sign OAuth state
SLACK_STATE_SECRET=

# App-level token (xapp-...) from Basic Information → App-Level Tokens
# Needs the connections:write scope for Socket Mode
SLACK_APP_TOKEN=

# Public HTTPS origin + path Slack redirects to after "Add to Slack"
# Must match the Redirect URL in OAuth & Permissions and manifest.json
SLACK_REDIRECT_URI=https://cfaslack.app/slack/oauth_redirect

# HTTP port for /slack/install and /slack/oauth_redirect (Socket Mode events do not use this)
PORT=3000

# Optional: on first boot, copy legacy ./config.json and quiz JSON into data/{id}/
DATA_TEAM_ID=
